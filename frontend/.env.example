# All VITE_* values are public browser configuration. Never add secrets.
# Auth wiring is not implemented in the foundation; these are future inputs.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_BROWSER_SAFE_PUBLISHABLE_KEY
# Only /api is accepted. Configure an HTTP reverse proxy instead of another origin.
VITE_API_BASE_URL=/api
