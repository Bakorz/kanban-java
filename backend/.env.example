# Runtime JDBC/Auth configuration template. Do not store real values in this tracked file.
# Tomcat needs environment injection; Java does not automatically load this file.
# JDBC_URL query accepts only sslmode=verify-full. No credentials or other driver options.
# Never put administrative or Supabase service-role credentials here.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_JWT_ISSUER=https://YOUR_PROJECT_REF.supabase.co/auth/v1
SUPABASE_JWKS_URL=https://YOUR_PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_AUDIENCE=authenticated
JDBC_URL=jdbc:postgresql://YOUR_DATABASE_HOST:5432/postgres?sslmode=verify-full
DB_USERNAME=YOUR_RESTRICTED_RUNTIME_ROLE
DB_PASSWORD=SET_PRIVATELY
DB_SSL_ROOT_CERT=/absolute/path/to/supabase-root.crt
DB_POOL_MAX_SIZE=5
DB_CONNECTION_TIMEOUT_MS=10000
DB_STATEMENT_TIMEOUT_MS=10000
